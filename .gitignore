# --- Secrets: never commit these ---
# .env holds the Anthropic API key. See .env.example for the template.
.env

# --- Personal data ---
# data/ holds the SQLite database (my cards and review history) and the app's
# log files. None of it belongs in git; the importer rebuilds the cards.
data/
*.log
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Python clutter ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editor / OS clutter ---
.vscode/
.idea/
Thumbs.db
desktop.ini
