# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so your real key never reaches GitHub.

# Get a key at https://console.anthropic.com/ (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Optional: where your flashcard HTML files live.
# Default: the "Flaschards" folder inside your Downloads folder.
# CARDS_DIR=C:\path\to\your\flashcards

# Optional: where to keep the database file.
# Default: data\flashcards.db inside this project.
# DB_PATH=C:\path\to\flashcards.db
