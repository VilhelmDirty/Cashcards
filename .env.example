# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so your real key never reaches GitHub.

# Get a key at https://console.anthropic.com/ (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Optional: email reminders. The account the app sends FROM.
# For Gmail: turn on 2-Step Verification, then create an "app password" at
# https://myaccount.google.com/apppasswords and paste its 16 characters below.
# Never use your normal Gmail password here.
# (Where emails are sent TO is set on the app's Settings page.)
SMTP_USER=
SMTP_PASSWORD=
# Only needed for providers other than Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Optional: where your flashcard HTML files live.
# Default: the "Flaschards" folder inside your Downloads folder.
# CARDS_DIR=C:\path\to\your\flashcards

# Optional: where to keep the database file.
# Default: data\flashcards.db inside this project.
# DB_PATH=C:\path\to\flashcards.db
